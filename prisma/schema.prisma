generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  logoUrl               String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  users         User[]
  invites       CompanyInvite[]
  integration      CompanyIntegration?
  brandConfig      CompanyBrandConfig?
  executions       WorkflowExecution[]
  socialStudioConfig SocialStudioConfig?
  socialStudioJobs   SocialStudioJob[]
  createAdJobs       CreateAdJob[]
  newsletterConfig   NewsletterConfig?
  newsletterTemplates NewsletterTemplate[]
  newsletterSubscribers NewsletterSubscriber[]
  newsletterCampaigns NewsletterCampaign[]
  outreachConfig      OutreachConfig?
  outreachLeadLists   OutreachLeadList[]
  outreachLeads       OutreachLead[]
  blogConfig          BlogConfig?
  blogCategories      BlogCategory[]
  blogJobs            BlogJob[]
  adAutomationDefaults AdAutomationDefaults?
  adAutomations        AdAutomation[]
  moduleAccess         CompanyModuleAccess?
  competitorAds        CompetitorAd[]
  adLibrarySearches    AdLibrarySearch[]
  adLibraryAds         AdLibraryAd[]

  @@map("companies")
}

model CompanyInvite {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String    @unique
  role        String    @default("COMPANY_MEMBER")
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@index([email])
  @@map("company_invites")
}

model CompanyIntegration {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  metaAccessTokenEnc      String?
  metaAdAccountId         String?
  metaPageId              String?
  elevenLabsApiKeyEnc     String?
  wordpressSiteUrl        String?
  wordpressUsername       String?
  wordpressAppPasswordEnc String?
  apiTokenSecretsEnc      String?
  aiRoutingConfig         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_integrations")
}

model CompanyBrandConfig {
  id               String   @id @default(cuid())
  companyId        String   @unique
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productsServices String   @default("") @map("products_services")
  valueProposition String   @default("") @map("value_proposition")
  brandVoice       String   @default("") @map("brand_voice")
  positioning      String   @default("") @map("positioning")
  competitors      String   @default("") @map("competitors")
  painPoints       String   @default("") @map("pain_points")
  icpMetaAds       String   @default("") @map("icp_meta_ads")
  icpNewsletter    String   @default("") @map("icp_newsletter")
  icpOutreach      String   @default("") @map("icp_outreach")
  icpColdDm        String   @default("") @map("icp_cold_dm")
  icpColdCall      String   @default("") @map("icp_cold_call")
  icpColdSms       String   @default("") @map("icp_cold_sms")
  icpBlog          String   @default("") @map("icp_blog")
  icpSocial        String   @default("") @map("icp_social")
  destinationUrl   String   @default("") @map("destination_url")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  snapshots CompanyBrandSnapshot[]

  @@map("company_brand_configs")
}

model CompanyBrandSnapshot {
  id               String             @id @default(cuid())
  brandConfigId    String             @map("brand_config_id")
  brandConfig      CompanyBrandConfig @relation(fields: [brandConfigId], references: [id], onDelete: Cascade)
  productsServices String             @default("") @map("products_services")
  valueProposition String             @default("") @map("value_proposition")
  brandVoice       String             @default("") @map("brand_voice")
  positioning      String             @default("") @map("positioning")
  competitors      String             @default("") @map("competitors")
  painPoints       String             @default("") @map("pain_points")
  icpMetaAds       String             @default("") @map("icp_meta_ads")
  icpNewsletter    String             @default("") @map("icp_newsletter")
  icpOutreach      String             @default("") @map("icp_outreach")
  icpColdDm        String             @default("") @map("icp_cold_dm")
  icpColdCall      String             @default("") @map("icp_cold_call")
  icpColdSms       String             @default("") @map("icp_cold_sms")
  icpBlog          String             @default("") @map("icp_blog")
  icpSocial        String             @default("") @map("icp_social")
  contentHash      String             @map("content_hash")
  label            String?
  createdAt        DateTime           @default(now()) @map("created_at")

  @@index([brandConfigId])
  @@map("company_brand_snapshots")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String
  role          String    @default("COMPANY_MEMBER")
  companyId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company    Company?            @relation(fields: [companyId], references: [id])
  executions WorkflowExecution[]
  sessions   Session[]
  auditLogs  AdminAuditLog[]

  @@index([email])
  @@index([companyId])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model WorkflowExecution {
  id             String    @id @default(cuid())
  userId         String
  companyId      String?
  workflowType   String
  workflowName   String?
  status         String    @default("PENDING")
  externalExecutionId String?
  inputData      String
  outputData     String?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  duration       Int?
  createdAt      DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  campaign   Campaign?
  scraperJob ScraperJob?
  cleanupLog CleanupLog?

  @@index([userId])
  @@index([companyId])
  @@index([workflowType])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("workflow_executions")
}

model Campaign {
  id                 String    @id @default(cuid())
  executionId        String    @unique
  campaignName       String
  serviceType        String
  targetRegion       String
  campaignGoal       String    @default("")
  campaignMessage    String    @default("")
  selectedSheet      String
  leadListId         String?   @map("lead_list_id")
  instantlyCampaignId String?  @map("instantly_campaign_id")
  totalLeadsSent     Int       @default(0)
  successfulSends    Int       @default(0)
  failedSends        Int       @default(0)
  aiGeneratedContent String?
  status             String    @default("PENDING_APPROVAL")
  approvedBy         String?
  approvedAt         DateTime?
  rejectedBy         String?
  rejectedAt         DateTime?
  rejectionReason    String?
  comments           String?
  createdBy          String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([campaignName])
  @@index([serviceType])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("campaigns")
}

model ScraperJob {
  id            String   @id @default(cuid())
  executionId   String   @unique
  niches        String
  location      String
  maxResults    Int
  totalScraped  Int      @default(0)
  validEmails   Int      @default(0)
  invalidEmails Int      @default(0)
  targetSheet   String
  apifyRunId    String?
  createdAt     DateTime @default(now())

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([location])
  @@index([createdAt(sort: Desc)])
  @@map("scraper_jobs")
}

model CleanupLog {
  id            String   @id @default(cuid())
  executionId   String   @unique
  totalContacts Int
  deletedCount  Int
  triggerType   String
  cleanupDate   DateTime @default(now())

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([cleanupDate(sort: Desc)])
  @@map("cleanup_logs")
}

model SocialStudioConfig {
  id               String   @id @default(cuid())
  companyId        String   @unique
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandAbout       String   @default("") @map("brand_about")
  brandMission     String   @default("") @map("brand_mission")
  brandServices    String   @default("") @map("brand_services")
  brandAudience    String   @default("") @map("brand_audience")
  brandWebsite     String   @default("") @map("brand_website")
  tone             String   @default("")
  defaultImageRatio String  @default("1:1") @map("default_image_ratio")
  uploadPostUser   String   @default("") @map("upload_post_user")
  facebookPageId   String   @default("") @map("facebook_page_id")
  linkedinOrgUrn   String   @default("") @map("linkedin_org_urn")
  tiktokHandle     String   @default("") @map("tiktok_handle")
  enabledPlatforms Json     @default("[\"facebook\",\"instagram\",\"linkedin\",\"tiktok\"]") @map("enabled_platforms")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("social_studio_configs")
}

model SocialStudioJob {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind         String
  status       String   @default("pending")
  input        Json     @default("{}")
  story        String?
  scenes       Json?
  assetUrl     String?  @map("asset_url")
  descriptions Json?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, kind])
  @@index([createdAt(sort: Desc)])
  @@map("social_studio_jobs")
}

model CreateAdJob {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      String
  status    String   @default("pending")
  input     Json     @default("{}")
  result    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([createdAt(sort: Desc)])
  @@map("create_ad_jobs")
}

model NewsletterConfig {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromEmail          String   @default("") @map("from_email")
  fromName           String   @default("") @map("from_name")
  replyTo            String   @default("") @map("reply_to")
  website            String   @default("")
  logoUrl            String   @default("") @map("logo_url")
  addressLine        String   @default("") @map("address_line")
  phone              String   @default("")
  unsubscribeBaseUrl String   @default("") @map("unsubscribe_base_url")
  sendHour           Int      @default(10) @map("send_hour")
  sendMinute         Int      @default(30) @map("send_minute")
  sendTimezone       String   @default("UTC") @map("send_timezone")
  dailyLimit         Int      @default(50) @map("daily_limit")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("newsletter_configs")
}

model NewsletterTemplate {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String   @default("newsletter")
  service        String   @default("")
  topic          String   @default("")
  subjectLine    String   @default("") @map("subject_line")
  preheader      String   @default("")
  html           String   @default("")
  structuredJson Json     @default("{}") @map("structured_json")
  createdAt      DateTime @default(now())

  campaigns NewsletterCampaign[]

  @@index([companyId])
  @@index([createdAt(sort: Desc)])
  @@map("newsletter_templates")
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email            String
  firstName        String   @default("") @map("first_name")
  lastName         String   @default("") @map("last_name")
  serviceType      String   @default("") @map("service_type")
  status           String   @default("subscribed")
  emailStatus      String   @default("verified") @map("email_status")
  unsubscribeToken String   @unique @default(cuid()) @map("unsubscribe_token")
  createdAt        DateTime @default(now())

  sends NewsletterSend[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, status, emailStatus])
  @@map("newsletter_subscribers")
}

model NewsletterCampaign {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  templateId    String   @map("template_id")
  template      NewsletterTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dailyLimit    Int      @default(50) @map("daily_limit")
  audienceLimit String   @default("All Subscribers") @map("audience_limit")
  status        String   @default("active")
  sentCount     Int      @default(0) @map("sent_count")
  sendHour      Int      @default(10) @map("send_hour")
  sendMinute    Int      @default(30) @map("send_minute")
  sendTimezone  String   @default("UTC") @map("send_timezone")
  lastRunAt     DateTime? @map("last_run_at")
  createdAt     DateTime @default(now())

  sends NewsletterSend[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([status])
  @@map("newsletter_native_campaigns")
}

model NewsletterSend {
  id           String   @id @default(cuid())
  campaignId   String   @map("campaign_id")
  campaign     NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId String   @map("subscriber_id")
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  status       String   @default("sent")
  resendId     String?  @map("resend_id")
  sentAt       DateTime @default(now()) @map("sent_at")

  @@unique([campaignId, subscriberId])
  @@index([campaignId])
  @@index([subscriberId])
  @@map("newsletter_sends")
}

model OutreachConfig {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instantlyCampaignId String   @default("") @map("instantly_campaign_id")
  senderName          String   @default("") @map("sender_name")
  defaultCtaLink      String   @default("") @map("default_cta_link")
  cleanupIntervalDays Int      @default(10) @map("cleanup_interval_days")
  cleanupBatchSize    Int      @default(100) @map("cleanup_batch_size")
  dailySendLimit      Int      @default(60) @map("daily_send_limit")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("outreach_configs")
}

model OutreachLeadList {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads OutreachLead[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("outreach_lead_lists")
}

model OutreachLead {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  listId       String   @map("list_id")
  list         OutreachLeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  firstName    String   @default("") @map("first_name")
  lastName     String   @default("") @map("last_name")
  email        String
  mobileNumber String   @default("") @map("mobile_number")
  linkedin     String   @default("")
  city         String   @default("")
  country      String   @default("")
  emailStatus  String   @default("pending") @map("email_status")
  isCatchAll   Boolean  @default(false) @map("is_catch_all")
  sentStatus   String   @default("not_sent") @map("sent_status")
  source       String   @default("apify")
  createdAt    DateTime @default(now())
  sentAt       DateTime? @map("sent_at")

  @@unique([companyId, email])
  @@index([companyId])
  @@index([listId])
  @@index([companyId, sentStatus])
  @@index([companyId, emailStatus, sentStatus])
  @@map("outreach_leads")
}

model BlogConfig {
  id                    String    @id @default(cuid())
  companyId             String    @unique
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  titlePrompt           String    @default("") @map("title_prompt")
  titleUserPrompt       String    @default("") @map("title_user_prompt")
  articleSystemPrompt   String    @default("") @map("article_system_prompt")
  articleUserPrompt     String    @default("") @map("article_user_prompt")
  imagePromptSystem     String    @default("") @map("image_prompt_system")
  runHour               Int       @default(7) @map("run_hour")
  runMinute             Int       @default(0) @map("run_minute")
  runTimezone           String    @default("UTC") @map("run_timezone")
  daysInterval          Int       @default(3) @map("days_interval")
  active                Boolean   @default(true)
  postStatus            String    @default("publish") @map("post_status")
  imageSize             String    @default("16:9") @map("image_size")
  dataForSeoLocationCode Int      @default(2124) @map("dataforseo_location_code")
  openAiModel           String    @default("gpt-4o-mini") @map("openai_model")
  lastCategoryIndex     Int       @default(0) @map("last_category_index")
  lastRunAt             DateTime? @map("last_run_at")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("blog_configs")
}

model BlogCategory {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service     String   @default("")
  category    String
  seedKeyword String   @default("") @map("seed_keyword")
  keywords    Json     @default("[]")
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs BlogJob[]

  @@index([companyId])
  @@index([companyId, active])
  @@map("blog_categories")
}

model BlogJob {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId      String?   @map("category_id")
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status          String    @default("pending")
  title           String?
  slug            String?
  articleHtml     String?   @map("article_html")
  imagePrompt     String?   @map("image_prompt")
  imageTaskId     String?   @map("image_task_id")
  imageUrl        String?   @map("image_url")
  wordpressPostId Int?      @map("wordpress_post_id")
  wordpressPostUrl String?  @map("wordpress_post_url")
  errorMessage    String?   @map("error_message")
  input           Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([createdAt(sort: Desc)])
  @@map("blog_jobs")
}

model AdAutomationDefaults {
  id               String   @id @default(cuid())
  companyId        String   @unique
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  numVariants      Int      @default(3) @map("num_variants")
  evalLengthDays   Int      @default(7) @map("eval_length_days")
  dailyBudgetCents Int      @default(100) @map("daily_budget_cents")
  winnerMetric     String   @default("objective_aware") @map("winner_metric")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("ad_automation_defaults")
}

model AdAutomation {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metaCampaignId    String?   @map("meta_campaign_id")
  metaAdSetId       String?   @map("meta_ad_set_id")
  baseAdMediaUrl    String    @map("base_ad_media_url")
  baseConcept       Json      @default("{}") @map("base_concept")
  numVariants       Int       @default(3) @map("num_variants")
  evalLengthDays    Int       @default(7) @map("eval_length_days")
  dailyBudgetCents  Int       @default(100) @map("daily_budget_cents")
  automationEnabled Boolean   @default(false) @map("automation_enabled")
  status            String    @default("generating")
  generation        Int       @default(1)
  nextEvaluationAt  DateTime? @map("next_evaluation_at")
  launchSchema      Json?     @map("launch_schema")
  error             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  variants AdVariant[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([status, nextEvaluationAt])
  @@index([createdAt(sort: Desc)])
  @@map("ad_automations")
}

model AdVariant {
  id           String   @id @default(cuid())
  automationId String   @map("automation_id")
  automation   AdAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  generation   Int      @default(1)
  metaAdId     String?  @map("meta_ad_id")
  mediaUrl     String   @map("media_url")
  format       String
  concept      Json     @default("{}")
  metrics      Json?
  role         String   @default("challenger")
  createdAt    DateTime @default(now())

  @@index([automationId])
  @@index([automationId, generation])
  @@index([automationId, role])
  @@map("ad_variants")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String   @map("actor_user_id")
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model CompetitorAd {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adId            String   @map("ad_id")
  pageName        String   @default("") @map("page_name")
  pageUrl         String   @default("") @map("page_url")
  adType          String   @default("text") @map("ad_type")
  startDate       String   @default("") @map("start_date")
  platforms       String   @default("")
  hook            String   @default("")
  headline        String   @default("")
  body            String   @default("")
  cta             String   @default("")
  caption         String   @default("")
  framework       String   @default("")
  angles          String[] @default([])
  hashtags        String[] @default([])
  keywords        String[] @default([])
  strength        String   @default("")
  score           Int      @default(0)
  imageUrl        String   @default("") @map("image_url")
  hasVideo        Boolean  @default(false) @map("has_video")
  impressionsText String?  @map("impressions_text")
  impressionsMin  Int?     @map("impressions_min")
  impressionsMax  Int?     @map("impressions_max")
  reachCountries  String[] @default([]) @map("reach_countries")
  adActive        Boolean? @map("ad_active")
  languageCode    String   @default("") @map("language_code")
  videoDurationSec Int?    @map("video_duration_sec")
  copyCharCount   Int      @default(0) @map("copy_char_count")
  raw             Json?
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime @updatedAt @map("last_seen_at")

  @@unique([companyId, adId])
  @@index([companyId, adType])
  @@index([companyId, lastSeenAt(sort: Desc)])
  @@map("competitor_ads")
}

model AdLibrarySearch {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  searchKey       String   @map("search_key")
  query           String   @default("")
  searchType      String   @default("keyword_unordered") @map("search_type")
  viewAllPageId   String   @default("") @map("view_all_page_id")
  countries       String[] @default([])
  activeStatus    String   @default("all") @map("active_status")
  adCategory      String   @default("all") @map("ad_category")
  mediaType       String   @default("all") @map("media_type")
  platforms       String[] @default([])
  languages       String[] @default([])
  startDateMin    String   @default("") @map("start_date_min")
  startDateMax    String   @default("") @map("start_date_max")
  actorId         String   @default("curious_coder") @map("actor_id")
  apifyRunId      String   @default("") @map("apify_run_id")
  apifyDatasetId  String   @default("") @map("apify_dataset_id")
  status          String   @default("queued")
  totalFound      Int      @default(0) @map("total_found")
  error           String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")
  finishedAt      DateTime? @map("finished_at")

  hits AdLibrarySearchHit[]

  @@unique([companyId, searchKey])
  @@index([companyId, status])
  @@map("ad_library_searches")
}

model AdLibraryAd {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adId            String   @map("ad_id")
  pageId          String   @default("") @map("page_id")
  pageName        String   @default("") @map("page_name")
  pageUrl         String   @default("") @map("page_url")
  adType          String   @default("text") @map("ad_type")
  startDate       String   @default("") @map("start_date")
  platforms       String   @default("")
  hook            String   @default("")
  headline        String   @default("")
  body            String   @default("")
  cta             String   @default("")
  caption         String   @default("")
  framework       String   @default("")
  angles          String[] @default([])
  hashtags        String[] @default([])
  keywords        String[] @default([])
  strength        String   @default("")
  score           Int      @default(0)
  imageUrl        String   @default("") @map("image_url")
  hasVideo        Boolean  @default(false) @map("has_video")
  impressionsText String?  @map("impressions_text")
  impressionsMin  Int?     @map("impressions_min")
  impressionsMax  Int?     @map("impressions_max")
  reachCountries  String[] @default([]) @map("reach_countries")
  adActive        Boolean? @map("ad_active")
  languageCode    String   @default("") @map("language_code")
  videoDurationSec Int?    @map("video_duration_sec")
  copyCharCount   Int      @default(0) @map("copy_char_count")
  raw             Json?
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime @updatedAt @map("last_seen_at")

  searchHits AdLibrarySearchHit[]

  @@unique([companyId, adId])
  @@index([companyId, adType])
  @@index([companyId, lastSeenAt(sort: Desc)])
  @@map("ad_library_ads")
}

model AdLibrarySearchHit {
  id            String         @id @default(cuid())
  searchId      String         @map("search_id")
  search        AdLibrarySearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  adLibraryAdId String         @map("ad_library_ad_id")
  ad            AdLibraryAd    @relation(fields: [adLibraryAdId], references: [id], onDelete: Cascade)
  position      Int            @default(0)

  @@unique([searchId, adLibraryAdId])
  @@index([searchId, position])
  @@map("ad_library_search_hits")
}

model CompanyModuleAccess {
  id                 String   @id @default(cuid())
  companyId          String   @unique @map("company_id")
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metaEnabled        Boolean  @default(true) @map("meta_enabled")
  socialEnabled      Boolean  @default(true) @map("social_enabled")
  newsletterEnabled  Boolean  @default(true) @map("newsletter_enabled")
  outreachEnabled    Boolean  @default(true) @map("outreach_enabled")
  blogEnabled        Boolean  @default(true) @map("blog_enabled")
  coldDmEnabled      Boolean  @default(true) @map("cold_dm_enabled")
  coldCallEnabled    Boolean  @default(true) @map("cold_call_enabled")
  coldSmsEnabled     Boolean  @default(true) @map("cold_sms_enabled")
  maintenanceMessage String   @default("This module is under maintenance. Please check back later.") @map("maintenance_message")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("company_module_access")
}
